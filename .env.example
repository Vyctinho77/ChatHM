# Copie para .env e ajuste. Nunca commite o .env.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://chathm:chathm@localhost:5432/chathm?sslmode=disable
AUTO_MIGRATE=true
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=chathm_session
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=2h
# Em dev (http://localhost) cookies Secure não funcionam em todos os navegadores.
COOKIE_SECURE=false
# MFA obrigatório para admin. Em produção a API recusa iniciar com false.
REQUIRE_ADMIN_MFA=false
# Só true atrás de proxy reverso confiável (usa X-Forwarded-For para IP/rate limit).
TRUST_PROXY_HEADERS=false

# Chave AES-256-GCM (32 bytes em base64) para segredos em repouso (MFA, sessão do WhatsApp).
# `make setup` acrescenta uma chave aleatória ao .env. Manual: openssl rand -base64 32
# Em produção, use um secret manager; nunca guarde a chave no banco.
# ENCRYPTION_KEY=

# Provedor do WhatsApp: whatsmeow (QR Code real) ou fake (simulado, só em development).
WHATSAPP_PROVIDER=whatsmeow

# Anexos: "fs" (disco local, cifrado com ENCRYPTION_KEY) ou "s3" (MinIO/AWS; usa as variáveis S3_* abaixo).
STORAGE_DRIVER=fs
STORAGE_DIR=./data/attachments
# Limite por arquivo (1–100 MB).
MAX_ATTACHMENT_MB=25
# Antivírus opcional (clamd, TCP). Se definido e indisponível, o anexo é recusado.
# CLAMAV_ADDR=localhost:3310

S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chathm-attachments
S3_ACCESS_KEY=chathm
S3_SECRET_KEY=chathm-dev-secret
S3_USE_SSL=false

# FFMPEG_BIN=C:\caminho\ffmpeg.exe
# FFPROBE_BIN=C:\caminho\ffprobe.exe

# Cadastro por conta própria na tela de entrada. Padrão: desligado (administradores criam os acessos em Equipe).
# Ligado, a conta nasce inativa e só entra depois que um administrador a ativar.
# ALLOW_SELF_REGISTER=false

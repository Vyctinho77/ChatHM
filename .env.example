# Copie para .env e ajuste. Nunca commite o .env.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://chathm:chathm@localhost:5432/chathm?sslmode=disable
AUTO_MIGRATE=true
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=chathm_session
SESSION_TTL=12h
# Em dev (http://localhost) cookies Secure não funcionam em todos os navegadores.
COOKIE_SECURE=false

# Chave AES-256-GCM (32 bytes em base64) para material de sessão do WhatsApp.
# Gere com: openssl rand -base64 32  — guarde fora do banco (secret manager em produção).
ENCRYPTION_KEY=

S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chathm-attachments
S3_ACCESS_KEY=chathm
S3_SECRET_KEY=chathm-dev-secret
S3_USE_SSL=false

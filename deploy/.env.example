# Domínio já apontado (registro A) para o IP do servidor. Ex.: atendimento.seuescritorio.com.br
DOMAIN=

# Senha do banco (gere: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Chave de 32 bytes em base64 (gere: openssl rand -base64 32).
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela a sessão do WhatsApp e os autenticadores não abrem mais.
ENCRYPTION_KEY=

# Código de instalação exigido na primeira tela (evita que um estranho conecte o número antes de você).
# Gere: openssl rand -hex 8
SETUP_TOKEN=

# Apenas desenvolvimento local. npm run dev carrega .env.development.local.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://chathm:chathm@127.0.0.1:5433/chathm_dev?sslmode=disable
TEST_DATABASE_URL=postgres://chathm:chathm@127.0.0.1:5433/chathm_dev?sslmode=disable
AUTO_MIGRATE=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=chathm_dev_session
# Mantém o login neste navegador por até 30 dias.
SESSION_TTL=720h
SESSION_IDLE_TIMEOUT=720h
# A sessão renova com o uso, até este teto desde o login.
SESSION_MAX_LIFETIME=2160h
COOKIE_SECURE=false
REQUIRE_ADMIN_MFA=false
TRUST_PROXY_HEADERS=false
WHATSAPP_PROVIDER=fake
STORAGE_DRIVER=fs
MAX_ATTACHMENT_MB=25
SEED_EXAMPLE_DATA=true
# ENCRYPTION_KEY e STORAGE_DIR são definidos pelo carregador de desenvolvimento.

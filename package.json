{
  "name": "chathm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "node scripts/dev-db.mjs start",
    "db:down": "node scripts/dev-db.mjs stop",
    "test:dev": "node --test scripts/dev-config.test.mjs scripts/dev-ready.test.mjs",
    "dev:web": "node --import ./scripts/dev-env.mjs ./apps/web/node_modules/vite/bin/vite.js apps/web",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
